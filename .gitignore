# Secrets — never commit
.env
*.pem
*.key

# Runtime state (per-machine watermarks, not shared)
state/*.json

# Generated reviews
reviews/*.md
reviews/*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# prime-agent session artifacts
.prime/sessions/
.prime/logs/

# Knowledge graphs mined from private repos are NOT tracked: they contain file
# paths of the reviewed repos. Only the public-repo example stays tracked.
graphs/*.json
graphs/*.md
!graphs/django-cochange.json

# Per-machine agent settings (contains an absolute local path)
.prime/agent/settings.json

# Stray pytest capture files from subagent runs
pytest_stdout.txt
pytest_stderr.txt

# OS
Thumbs.db
.DS_Store
# Windows artifact from a stray `2>nul` redirect in a shell command
nul

# Subagent verdict/payload handoff files (runtime)
state/verdicts/

# Evaluation harness runtime artifacts (results are committed under docs/eval/)
eval/corpus/
eval/runs/
