# Copy to .env and fill in. .env is gitignored — never commit real values.

# GitHub token for the target repo.
#   dry_run = true  -> needs: repo:status, public_repo (or repo for private) READ
#   dry_run = false -> additionally needs write access to post PR comments
GITHUB_TOKEN=

# Where the digest gets pushed each sweep.
# Slack:   https://hooks.slack.com/services/...
# Discord: https://discord.com/api/webhooks/...
PRIME_REVIEW_WEBHOOK_URL=
